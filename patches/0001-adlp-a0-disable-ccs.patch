 #define intel_device_info_is_bmg_g31(devinfo) (devinfo->gfx_ip_ver == BMG_G31_IP_VER)
 
+/* Wa_22011186057: ADL-P A0 cannot use CCS surface compression.
+ * Restored for engineering samples after upstream removed pre-production
+ * support in f7e39c6f8545540ed573a6b1036710b55f7d6778 (Mesa 23.3).
+ * Keep the original GT2/revision-0 scope; retail steppings are unaffected.
+ */
+static inline bool
+intel_device_info_needs_adlp_a0_ccs_wa(const struct intel_device_info *devinfo)
+{
+   return devinfo->platform == INTEL_PLATFORM_ADL &&
+          devinfo->gt == 2 && devinfo->revision == 0;
+}
