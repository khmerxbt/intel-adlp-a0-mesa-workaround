diff --git a/src/intel/isl/tests/isl_adlp_a0_ccs_test.c b/src/intel/isl/tests/isl_adlp_a0_ccs_test.c
new file mode 100644
index 0000000..81907d5
--- /dev/null
+++ b/src/intel/isl/tests/isl_adlp_a0_ccs_test.c
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: MIT */
+#include <stdio.h>
+#include <inttypes.h>
+#include <stdlib.h>
+#include "dev/intel_device_info.h"
+#include "isl/isl.h"
+#include "isl/isl_priv.h"
+#include "drm-uapi/drm_fourcc.h"
+
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "line %d: %s\n", __LINE__, #c); abort(); } } while (0)
+
+static void
+check_device(unsigned pci_id, unsigned revision, bool affected)
+{
+   struct intel_device_info info;
+   CHECK(intel_get_device_info_from_pci_id(pci_id, &info));
+   info.revision = revision;
+   struct isl_device dev;
+   isl_device_init(&dev, &info);
+   CHECK(intel_device_info_needs_adlp_a0_ccs_wa(&info) == affected);
+   CHECK(isl_format_supports_ccs_e(&info, ISL_FORMAT_R8G8B8A8_UNORM) == !affected);
+   CHECK(_isl_surf_info_supports_ccs(&dev, ISL_FORMAT_R8G8B8A8_UNORM,
+                                  ISL_SURF_USAGE_RENDER_TARGET_BIT) == !affected);
+   CHECK((isl_drm_modifier_get_score(&info, I915_FORMAT_MOD_Y_TILED_GEN12_RC_CCS) != 0) == !affected);
+   if (affected) {
+      CHECK(isl_drm_modifier_get_score(&info, I915_FORMAT_MOD_Y_TILED_GEN12_MC_CCS) == 0);
+      CHECK(isl_drm_modifier_get_score(&info, I915_FORMAT_MOD_Y_TILED_GEN12_RC_CCS_CC) == 0);
+   }
+   struct isl_surf surf;
+   bool init_ok = isl_surf_init(&dev, &surf,
+      .dim = ISL_SURF_DIM_2D, .format = ISL_FORMAT_R8G8B8A8_UNORM,
+      .width = 64, .height = 64, .depth = 1, .levels = 1,
+      .array_len = 1, .samples = 1,
+      .usage = ISL_SURF_USAGE_RENDER_TARGET_BIT | ISL_SURF_USAGE_TEXTURE_BIT,
+      .tiling_flags = ISL_TILING_Y0_BIT);
+   CHECK(init_ok);
+   CHECK(isl_surf_supports_ccs(&dev, &surf, NULL) == !affected);
+   CHECK(isl_drm_modifier_get_score(&info, I915_FORMAT_MOD_Y_TILED) != 0);
+   CHECK(isl_drm_modifier_get_score(&info, DRM_FORMAT_MOD_LINEAR) != 0);
+}
+
+int main(void)
+{
+   /* Match the NAS, later retail revisions, and unrelated GT1/Tiger Lake. */
+   check_device(0x46a1, 0, true);
+   check_device(0x46a1, 4, false);
+   check_device(0x4680, 0, false);
+   check_device(0x9a49, 0, false);
+   /* An explicit modifier override must not bypass the ES safety rule. */
+   struct intel_device_info info;
+   CHECK(intel_get_device_info_from_pci_id(0x46a1, &info));
+   info.revision = 0;
+   char modifier[32];
+   snprintf(modifier, sizeof(modifier), "%" PRIu64,
+            (uint64_t)I915_FORMAT_MOD_Y_TILED_GEN12_RC_CCS);
+   CHECK(setenv("INTEL_MODIFIER_OVERRIDE", modifier, 1) == 0);
+   CHECK(isl_drm_modifier_get_score(&info, I915_FORMAT_MOD_Y_TILED_GEN12_RC_CCS) == 0);
+   info.revision = 4;
+   CHECK(isl_drm_modifier_get_score(&info, I915_FORMAT_MOD_Y_TILED_GEN12_RC_CCS) != 0);
+   puts("ADL-P A0 CCS allocation/modifier restrictions and controls passed");
+   return 0;
+}
